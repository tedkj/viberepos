// VibeRepos's own icons, on the VibeWare 16-unit grid (1-unit strokes, 0/45/90 degrees,
// axis-aligned strokes on half units). The shared set lives in @vibeware.

export global AppIcons {
    // Save CSV: a sheet with the download arrow (VibeScan's).
    out property <string> save: "M 3.5 1.5 L 9.5 1.5 L 12.5 4.5 L 12.5 14.5 L 3.5 14.5 Z M 8.5 6 L 8.5 12 M 6 9.5 L 8.5 12 L 11 9.5";
    // Fetch all: an arrow down into a tray.
    out property <string> fetch: "M 8.5 1.5 L 8.5 10 M 5 6.5 L 8.5 10 L 12 6.5 M 2.5 9.5 L 2.5 14.5 L 14.5 14.5 L 14.5 9.5";
    // Roots: a folder with a branch mark.
    out property <string> roots: "M 1.5 3.5 L 6.5 3.5 L 8.5 5.5 L 15.5 5.5 L 15.5 13.5 L 1.5 13.5 Z M 6.5 8 L 6.5 12 M 6.5 10.5 L 10.5 8.5";
}
